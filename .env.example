# Copy this to .env for local testing: cp .env.example .env
# Never commit .env to GitHub.

# Anthropic API key — https://console.anthropic.com/keys
ANTHROPIC_API_KEY=sk-ant-...

# Tavily API key (free tier: 1,000 searches/month) — https://app.tavily.com
TAVILY_API_KEY=tvly-...

# Gmail address used to SEND the email (your Google account)
GMAIL_ADDRESS=you@gmail.com

# Gmail App Password (NOT your regular password)
# Generate at: https://myaccount.google.com/apppasswords
# Requires 2-Step Verification to be enabled on your Google account.
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
